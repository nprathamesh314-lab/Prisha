# ==============================================================================
# PRISHA XPRESS PVT. LTD. - SUPABASE ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to '.env' in the project root directory.
#
# Obtain these values from your Supabase Dashboard:
# 1. Go to https://supabase.com/dashboard/project/<your-project-ref>/settings/api
# 2. Copy "Project URL" and paste into VITE_SUPABASE_URL
# 3. Copy "anon public" API Key and paste into VITE_SUPABASE_ANON_KEY
# ==============================================================================

# 1. Supabase Project URL (HTTPS endpoint)
VITE_SUPABASE_URL=

# 2. Supabase Anonymous Public Key (Safe for browser / client-side queries)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
