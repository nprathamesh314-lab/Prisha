# ==============================================================================
# PRISHA XPRESS PVT. LTD. - COMPLETE ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to '.env' in the project root directory and supply your live credentials.
# ==============================================================================

# 1. Supabase Project Configuration (Obtain from Supabase Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# 2. Transactional Email Provider (Resend Integration for Business Enquiries)
# Obtain from https://resend.com/api-keys
VITE_RESEND_API_KEY=re_your_resend_api_key_here

# 3. Company Notification Recipient & Sender Identities
VITE_ADMIN_NOTIFICATION_EMAIL=enquiries@prishaxpress.com
VITE_EMAIL_FROM="Prisha Xpress <onboarding@resend.dev>"
